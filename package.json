{
  "name": "baudloom",
  "version": "0.1.8",
  "private": true,
  "description": "A local serial workbench with durable session records",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run build && electron .",
    "test:desktop": "npm run build && node tests/desktop-smoke.cjs && node tests/workflow-desktop.cjs && node tests/two-pane-desktop.cjs && node tests/tabs-desktop.cjs",
    "package:linux": "npm run build && node scripts/package.mjs linux",
    "package:win": "npm run build && node scripts/package.mjs win32",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/*.{ts,cjs}\" \"scripts/*.mjs\" package.json tsconfig.json .github/workflows/verify.yml",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"tests/*.{ts,cjs}\" \"scripts/*.mjs\" package.json tsconfig.json .github/workflows/verify.yml",
    "icons": "node scripts/generate-icons.mjs",
    "benchmark": "node --import tsx tests/performance-benchmark.ts",
    "benchmark:soak": "node --import tsx tests/soak-benchmark.ts",
    "benchmark:desktop": "npm run build && node tests/desktop-performance.cjs"
  },
  "dependencies": {
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "author": "Baudloom contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oniums/baudloom.git"
  },
  "homepage": "https://github.com/Oniums/baudloom",
  "bugs": {
    "url": "https://github.com/Oniums/baudloom/issues"
  }
}
